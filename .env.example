# MiniSoporte backend — environment template.
# Copy to .env and fill in real values; .env is Git-excluded (never commit it).
# Only the variables required by the CURRENT story are documented here.
# Later stories add DEMO_* / ANDROID_* vars — do not add them here until then.

# PostgreSQL connection string for SQLAlchemy/psycopg3 (local dev via infra/docker-compose.yml).
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/minisoporte

# Secret used to sign JWT HS256 bearer tokens. Replace with a long random value in any real environment.
JWT_SECRET=change-me

# Deployment environment name; one of: development | internal-test | test.
ENVIRONMENT=development

# Failed sign-in throttling (US-002): max failed attempts per client IP inside the sliding window.
LOGIN_RATELIMIT_IP_MAX=5

# Failed sign-in throttling (US-002): max failed attempts per submitted email inside the window.
LOGIN_RATELIMIT_EMAIL_MAX=5

# Failed sign-in throttling (US-002): sliding-window length in seconds.
LOGIN_RATELIMIT_WINDOW_SECONDS=900

# Demo-seed credentials (US-010): used ONLY by `python -m app.seed.demo_seed`.
# Optional at app startup; mandatory for the seed command. Placeholders ONLY —
# replace in any non-throwaway environment. The seed refuses to run when
# ENVIRONMENT=production.
DEMO_SUPPORT_EMAIL=soporte@minisoporte.test
DEMO_EMPLOYEE_PASSWORD=change-me-demo-password
DEMO_SUPPORT_PASSWORD=change-me-demo-password

# Integration-test PostgreSQL (US-001 conftest): SQLAlchemy/psycopg3 URL for the
# throwaway test database. Unset = integration tests skip (Testcontainers fallback).
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/minisoporte_test
